<% layout("/layouts/boilerplate.ejs") %>
<body>
    <h2>All Listings</h2>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(list of allListing){ %>
      <a href="/listings/<%=list._id%>" class="listing-link">
       <div class="card ">
    <img src="<%=list.image.url%>" class="card-img-top hover-card" alt="listing_image" style="height: 18rem;">
    <div class="card-body">
    <p class="card-text"><b><%= list.title%></b> <br>
&#8377;<%= (list.price || 0).toLocaleString("en-IN") %> /per night    </p>
  </div>
</div>
      </a>
    
<%}%>
  </div>
</body>
