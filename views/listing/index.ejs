<% layout("/layouts/boilerplate.ejs") %>

<body>
  <style>
    .filters {
      display: flex;
      flex-wrap: wrap;
      margin-top: 1rem;
      
    }

    .filter {
      text-align: center;
      margin-right: 2rem;
      margin-top: 1rem;
      opacity: 0.7;
      color: black;
      
    }

    .filter p {
      font-size: 0.8rem;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
    }

    .tax-switch {
      border: 1px solid grey;
      border-radius: 1rem;
      height: 3rem;
      padding: 1rem;
      margin-left: 3rem;
      display: flex;
      align-items: center;
    }

    .tax-info{
      display: none;
    }
  </style>

  <!-- Filters -->
<div class="filters">
  <a href="/listings?category=trending" class="filter <%= category === 'trending' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-fire"></i>
    </div>
    <p>Trending</p>
  </a>

  <a href="/listings?category=beach" class="filter <%= category === 'beach' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-umbrella-beach"></i>
    </div>
    <p>Beach</p>
  </a>

  <a href="/listings?category=castles" class="filter <%= category === 'castles' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-chess-rook"></i>
    </div>
    <p>Castles</p>
  </a>

  <a href="/listings?category=mountains" class="filter <%= category === 'mountains' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-mountain"></i>
    </div>
    <p>Mountains</p>
  </a>

  <a href="/listings?category=farms" class="filter <%= category === 'farms' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-tractor"></i>
    </div>
    <p>Farms</p>
  </a>

  <a href="/listings?category=cabins" class="filter <%= category === 'cabins' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-house"></i>
    </div>
    <p>Cabins</p>
  </a>

  <a href="/listings?category=treehouses" class="filter <%= category === 'treehouses' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-tree"></i>
    </div>
    <p>Treehouses</p>
  </a>

  <a href="/listings?category=camping" class="filter <%= category === 'camping' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-campground"></i>
    </div>
    <p>Camping</p>
  </a>

  <a href="/listings?category=lakefront" class="filter <%= category === 'lakefront' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-water"></i>
    </div>
    <p>Lakefront</p>
  </a>

  <a href="/listings?category=islands" class="filter <%= category === 'islands' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-water"></i>
    </div>
    <p>Islands</p>
  </a>

  <a href="/listings?category=desert" class="filter <%= category === 'desert' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-sun"></i>
    </div>
    <p>Desert</p>
  </a>

  <a href="/listings?category=snow" class="filter <%= category === 'snow' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-snowflake"></i>
    </div>
    <p>Snow</p>
  </a>

  <a href="/listings?category=luxury" class="filter <%= category === 'luxury' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-gem"></i>
    </div>
    <p>Luxury</p>
  </a>

  <a href="/listings?category=historic" class="filter <%= category === 'historic' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-landmark"></i>
    </div>
    <p>Historic</p>
  </a>

  <a href="/listings?category=amazing-views" class="filter <%= category === 'amazing-views' ? 'active' : '' %>">
    <div class="icon">
      <i class="fa-solid fa-binoculars"></i>
    </div>
    <p>Amazing Views</p>
  </a>
</div>

  <!-- Listings -->
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for (let list of allListing) { %>
      <a href="/listings/<%= list._id %>" class="listing-link">
        <div class="card">
          <img
            src="<%= list.image.url %>"
            class="card-img-top hover-card"
            alt="listing_image"
            style="height: 18rem;"
          />
          <div class="card-body">
            <p class="card-text">
              <b><%= list.title %></b> <br />
              &#8377;<%= (list.price || 0).toLocaleString("en-IN") %> / per night
              <i class="tax-info">&nbsp;+18% GST</i>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</body>