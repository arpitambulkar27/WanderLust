<% layout("/layouts/boilerplate.ejs") %>

<body>
  <style>
    .filters {
      display: flex;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    .filter {
      text-align: center;
      margin-right: 2rem;
      margin-top: 1rem;
      opacity: 0.7;
    }

    .filter p {
      font-size: 0.8rem;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
    }

    .tax-switch {
      border: 1px solid grey;
      border-radius: 1rem;
      height: 3rem;
      padding: 1rem;
      margin-left: 3rem;
      display: flex;
      align-items: center;
    }

    .tax-info{
      display: none;
    }
  </style>

  <!-- Filters -->
  <div class="filters">
    <div class="filter">
      <div class="icon">
        <i class="fa-solid fa-fire"></i>
      </div>
      <p>Trending</p>
    </div>

    <div class="filter">
      <div class="icon">
        <i class="fa-solid fa-bed"></i>
      </div>
      <p>Rooms</p>
    </div>

    <div class="filter">
      <div class="icon">
        <i class="fa-solid fa-city"></i>
      </div>
      <p>Iconic Cities</p>
    </div>

    <div class="filter">
      <div class="icon">
        <i class="fa-brands fa-fort-awesome"></i>
      </div>
      <p>Castles</p>
    </div>

    <div class="filter">
      <div class="icon">
        <i class="fa-solid fa-mountain"></i>
      </div>
      <p>Mountains</p>
    </div>

    <div class="filter">
      <div class="icon">
        <i class="fa-solid fa-person-swimming"></i>
      </div>
      <p>Amazing pools</p>
    </div>

    <div class="filter">
      <div class="icon">
        <i class="fa-solid fa-cow"></i>
      </div>
      <p>Farms</p>
    </div>

    <div class="filter">
      <div class="icon">
        <i class="fa-solid fa-campground"></i>
      </div>
      <p>Camping</p>
    </div>

    <div class="filter">
      <div class="icon">
        <i class="fa-solid fa-snowman"></i>
      </div>
      <p>Arctic</p>
    </div>

    <div class="filter">
      <div class="icon">
        <i class="fa-solid fa-landmark-dome"></i>
      </div>
      <p>Domes</p>
    </div>

    <div class="filter">
      <div class="icon">
        <i class="fa-solid fa-ship"></i>
      </div>
      <p>Boats</p>
    </div>

    <!-- Tax Toggle -->
    <div class="tax-switch">
      <div class="form-check-reverse form-switch">
        <input
          class="form-check-input"
          type="checkbox"
          role="switch"
          id="flexSwitchCheckDefault"
        />
        <label class="form-check-label" for="flexSwitchCheckDefault">
          Display after taxes
        </label>
      </div>
    </div>
  </div>

  <!-- Listings -->
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for (let list of allListing) { %>
      <a href="/listings/<%= list._id %>" class="listing-link">
        <div class="card">
          <img
            src="<%= list.image.url %>"
            class="card-img-top hover-card"
            alt="listing_image"
            style="height: 18rem;"
          />
          <div class="card-body">
            <p class="card-text">
              <b><%= list.title %></b> <br />
              &#8377;<%= (list.price || 0).toLocaleString("en-IN") %> / per night
              <i class="tax-info">&nbsp;+18% GST</i>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</body>

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");

  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display!="inline"){
       info.style.display="inline";
      }else{
        info.style.display="none";
      }
      
    }
  });

  
</script>