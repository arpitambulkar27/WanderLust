<% layout("/layouts/boilerplate.ejs") %>

<!-- Category Scroll & Tax Switch Header Container -->
<div class="d-flex align-items-center justify-content-between gap-3 categories-wrapper">
  <!-- Scroll Left Button -->
  <button class="scroll-btn d-none d-md-flex" id="scrollLeftBtn" aria-label="Scroll left">
    <i class="fa-solid fa-chevron-left text-secondary"></i>
  </button>

  <!-- Categories Scroll Track -->
  <div class="categories-scroll flex-fill">
    <a href="/listings" class="category-item <%= !locals.category ? 'active' : '' %>">
      <i class="fa-solid fa-border-all"></i>
      <span>All Places</span>
    </a>
    <a href="/listings?category=trending" class="category-item <%= locals.category === 'trending' ? 'active' : '' %>">
      <i class="fa-solid fa-fire"></i>
      <span>Trending</span>
    </a>
    <a href="/listings?category=beach" class="category-item <%= locals.category === 'beach' ? 'active' : '' %>">
      <i class="fa-solid fa-umbrella-beach"></i>
      <span>Beach</span>
    </a>
    <a href="/listings?category=castles" class="category-item <%= locals.category === 'castles' ? 'active' : '' %>">
      <i class="fa-solid fa-chess-rook"></i>
      <span>Castles</span>
    </a>
    <a href="/listings?category=mountains" class="category-item <%= locals.category === 'mountains' ? 'active' : '' %>">
      <i class="fa-solid fa-mountain"></i>
      <span>Mountains</span>
    </a>
    <a href="/listings?category=farms" class="category-item <%= locals.category === 'farms' ? 'active' : '' %>">
      <i class="fa-solid fa-tractor"></i>
      <span>Farms</span>
    </a>
    <a href="/listings?category=cabins" class="category-item <%= locals.category === 'cabins' ? 'active' : '' %>">
      <i class="fa-solid fa-house"></i>
      <span>Cabins</span>
    </a>
    <a href="/listings?category=treehouses" class="category-item <%= locals.category === 'treehouses' ? 'active' : '' %>">
      <i class="fa-solid fa-tree"></i>
      <span>Treehouses</span>
    </a>
    <a href="/listings?category=camping" class="category-item <%= locals.category === 'camping' ? 'active' : '' %>">
      <i class="fa-solid fa-campground"></i>
      <span>Camping</span>
    </a>
    <a href="/listings?category=lakefront" class="category-item <%= locals.category === 'lakefront' ? 'active' : '' %>">
      <i class="fa-solid fa-water"></i>
      <span>Lakefront</span>
    </a>
    <a href="/listings?category=islands" class="category-item <%= locals.category === 'islands' ? 'active' : '' %>">
      <i class="fa-solid fa-island-tropical"></i>
      <span>Islands</span>
    </a>
    <a href="/listings?category=desert" class="category-item <%= locals.category === 'desert' ? 'active' : '' %>">
      <i class="fa-solid fa-sun"></i>
      <span>Desert</span>
    </a>
    <a href="/listings?category=snow" class="category-item <%= locals.category === 'snow' ? 'active' : '' %>">
      <i class="fa-solid fa-snowflake"></i>
      <span>Snow</span>
    </a>
    <a href="/listings?category=luxury" class="category-item <%= locals.category === 'luxury' ? 'active' : '' %>">
      <i class="fa-solid fa-gem"></i>
      <span>Luxury</span>
    </a>
    <a href="/listings?category=historic" class="category-item <%= locals.category === 'historic' ? 'active' : '' %>">
      <i class="fa-solid fa-landmark"></i>
      <span>Historic</span>
    </a>
    <a href="/listings?category=amazing-views" class="category-item <%= locals.category === 'amazing-views' ? 'active' : '' %>">
      <i class="fa-solid fa-binoculars"></i>
      <span>Amazing Views</span>
    </a>
  </div>

  <!-- Scroll Right Button -->
  <button class="scroll-btn d-none d-md-flex" id="scrollRightBtn" aria-label="Scroll right">
    <i class="fa-solid fa-chevron-right text-secondary"></i>
  </button>

  <!-- Tax Switch Toggle Box -->
  <div class="tax-toggle-box ms-md-3 d-none d-lg-flex">
    <div class="form-check form-switch p-0 m-0 d-flex align-items-center gap-2">
      <label class="form-check-label text-dark small fw-bold cursor-pointer" for="flexSwitchCheckDefault">
        Display total before taxes
      </label>
      <input class="form-check-input m-0 ms-2" type="checkbox" role="switch" id="flexSwitchCheckDefault">
    </div>
  </div>
</div>

<!-- Listings Cards Grid -->
<% if (allListing.length === 0) { %>
  <div class="text-center py-5 my-5">
    <i class="fa-solid fa-magnifying-glass fs-1 text-muted mb-3"></i>
    <h4 class="fw-bold">No stays found</h4>
    <p class="text-secondary">Try searching for a different destination or clearing your category filters.</p>
    <a href="/listings" class="btn btn-dark rounded-pill px-4">View All Listings</a>
  </div>
<% } else { %>
  <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
    <% for (let list of allListing) { %>
      <div class="col listing-card-wrapper">
        <a href="/listings/<%= list._id %>" class="listing-card">
          <!-- Card Image & Wishlist Button Container -->
          <div class="card-img-container">
            <img
              src="<%= list.image && list.image.url ? list.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=60' %>"
              alt="<%= list.title %>"
              loading="lazy"
            />
            <button class="wishlist-btn" data-id="<%= list._id %>" aria-label="Add to Wishlist">
              <i class="fa-regular fa-heart"></i>
            </button>
            <span class="guest-favorite-badge">Guest favorite</span>
          </div>

          <!-- Card Details -->
          <div class="card-details">
            <div class="card-header-row">
              <h5 class="card-title-text"><%= list.title %></h5>
              <div class="card-rating">
                <i class="fa-solid fa-star"></i>
                <span>4.92</span>
              </div>
            </div>
            <p class="card-subtitle"><%= list.location %>, <%= list.country %></p>
            <p class="card-subtitle text-secondary">Added recently</p>
            <div class="card-price-row">
              <span class="card-price-amount">₹<%= (list.price || 0).toLocaleString("en-IN") %></span>
              <span class="text-secondary fw-normal">/ night</span>
              <span class="tax-info">&nbsp;+18% GST</span>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>