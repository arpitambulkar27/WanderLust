<% layout("/layouts/boilerplate.ejs") %>

<div class="container py-4">
  <!-- Header Title & Subheader -->
  <div class="show-header">
    <h1 class="show-title"><%= hotel.title %></h1>
    <div class="show-sub-header">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="fw-bold"><i class="fa-solid fa-star text-dark"></i> 4.92</span>
        <span>&middot;</span>
        <span class="fw-semibold text-decoration-underline"><%= hotel.review ? hotel.review.length : 0 %> reviews</span>
        <span>&middot;</span>
        <span class="badge bg-light text-dark border"><i class="fa-solid fa-medal text-warning me-1"></i>Superhost</span>
        <span>&middot;</span>
        <span class="fw-semibold text-decoration-underline"><%= hotel.location %>, <%= hotel.country %></span>
      </div>

      <div class="action-btn-group">
        <button class="show-action-btn">
          <i class="fa-solid fa-arrow-up-from-bracket"></i> Share
        </button>
        <button class="show-action-btn wishlist-btn" data-id="<%= hotel._id %>">
          <i class="fa-regular fa-heart"></i> Save
        </button>
      </div>
    </div>
  </div>

  <!-- Photo Gallery Grid (Airbnb 5-image style) -->
  <div class="gallery-grid">
    <div class="gallery-item gallery-main">
      <img
        src="<%= hotel.image && hotel.image.url ? hotel.image.url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80' %>"
        alt="<%= hotel.title %>"
      />
    </div>
    <div class="gallery-item gallery-secondary d-none d-md-block">
      <img
        src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=600&q=80"
        alt="Interior 1"
      />
    </div>
    <div class="gallery-item gallery-secondary d-none d-md-block">
      <img
        src="https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=600&q=80"
        alt="Interior 2"
      />
    </div>
    <div class="gallery-item gallery-secondary d-none d-md-block">
      <img
        src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=600&q=80"
        alt="Interior 3"
      />
    </div>
    <div class="gallery-item gallery-secondary d-none d-md-block">
      <img
        src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=600&q=80"
        alt="Interior 4"
      />
    </div>
  </div>

  <div class="row g-5">
    <!-- Left Column: Details & Amenities -->
    <div class="col-lg-7">
      <!-- Host Header -->
      <div class="host-profile-box">
        <div class="host-avatar-lg">
          <%= hotel.owner && hotel.owner.username ? hotel.owner.username.charAt(0).toUpperCase() : 'H' %>
        </div>
        <div>
          <h5 class="fw-bold mb-1">Hosted by <%= hotel.owner ? hotel.owner.username : 'Host' %></h5>
          <p class="text-secondary small mb-0">Superhost &middot; 3 years hosting</p>
        </div>
      </div>

      <!-- Highlights Row -->
      <div class="feature-badge-row flex-column">
        <div class="feature-badge-item mb-3">
          <i class="fa-solid fa-door-open"></i>
          <div>
            <h6 class="fw-bold mb-0">Self check-in</h6>
            <small class="text-secondary">Check yourself in with the keypad.</small>
          </div>
        </div>
        <div class="feature-badge-item mb-3">
          <i class="fa-solid fa-location-dot"></i>
          <div>
            <h6 class="fw-bold mb-0">Great location</h6>
            <small class="text-secondary">95% of recent guests gave the location a 5-star rating.</small>
          </div>
        </div>
        <div class="feature-badge-item">
          <i class="fa-solid fa-calendar-check"></i>
          <div>
            <h6 class="fw-bold mb-0">Free cancellation for 48 hours</h6>
            <small class="text-secondary">Full refund if you change your mind.</small>
          </div>
        </div>
      </div>

      <!-- Description Section -->
      <div class="pb-4 border-bottom mb-4">
        <h5 class="fw-bold mb-3">About this space</h5>
        <p class="text-dark lh-base"><%= hotel.description %></p>
      </div>

      <!-- Amenities Grid -->
      <div class="pb-4 border-bottom mb-4">
        <h5 class="fw-bold mb-3">What this place offers</h5>
        <div class="amenity-grid">
          <div class="amenity-item"><i class="fa-solid fa-wifi"></i> Fast Wi-Fi</div>
          <div class="amenity-item"><i class="fa-solid fa-car"></i> Free driveway parking</div>
          <div class="amenity-item"><i class="fa-solid fa-utensils"></i> Chef's Kitchen</div>
          <div class="amenity-item"><i class="fa-solid fa-laptop"></i> Dedicated workspace</div>
          <div class="amenity-item"><i class="fa-solid fa-snowflake"></i> Air conditioning</div>
          <div class="amenity-item"><i class="fa-solid fa-water-ladder"></i> Swimming pool</div>
          <div class="amenity-item"><i class="fa-solid fa-tv"></i> 55" HDTV with Netflix</div>
          <div class="amenity-item"><i class="fa-solid fa-shirt"></i> In-unit Washer & Dryer</div>
        </div>
      </div>

      <!-- Owner Actions (Edit / Delete Listing) -->
      <% if(currUser && hotel.owner && hotel.owner._id.equals(currUser._id)){ %>
        <div class="d-flex gap-2 my-4 p-3 bg-light rounded-3 border">
          <a href="/listings/<%= hotel._id %>/edit" class="btn btn-outline-dark px-4 fw-bold">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
          </a>
          <form method="POST" action="/listings/<%= hotel._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-danger px-4 fw-bold" onclick="return confirm('Are you sure you want to delete this listing?')">
              <i class="fa-solid fa-trash me-1"></i> Delete Listing
            </button>
          </form>
        </div>
      <% } %>
    </div>

    <!-- Right Column: Sticky Booking Widget -->
    <div class="col-lg-5">
      <div class="booking-widget-card">
        <div class="widget-price-header">
          <div class="widget-price">
            ₹<span id="pricePerNightVal" data-price="<%= hotel.price || 0 %>"><%= (hotel.price || 0).toLocaleString("en-IN") %></span>
            <span>/ night</span>
          </div>
          <div class="small fw-bold">
            <i class="fa-solid fa-star"></i> 4.92 &middot; <span class="text-secondary text-decoration-underline"><%= hotel.review ? hotel.review.length : 0 %> reviews</span>
          </div>
        </div>

        <!-- Reserve Form -->
        <form action="/listings/<%= hotel._id %>/bookings" method="POST" class="needs-validation" novalidate>
          <div class="date-picker-box">
            <div class="row g-0">
              <div class="col-6 date-input-col">
                <label for="checkIn">CHECK-IN</label>
                <input
                  type="text"
                  id="checkIn"
                  name="booking[checkIn]"
                  placeholder="Add date"
                  required
                />
              </div>
              <div class="col-6 date-input-col">
                <label for="checkOut">CHECKOUT</label>
                <input
                  type="text"
                  id="checkOut"
                  name="booking[checkOut]"
                  placeholder="Add date"
                  required
                />
              </div>
              <div class="col-12 date-input-col">
                <label for="guests">GUESTS</label>
                <select id="guests" name="booking[guests]" class="form-select border-0 p-0 shadow-none">
                  <option value="1" selected>1 guest</option>
                  <option value="2">2 guests</option>
                  <option value="3">3 guests</option>
                  <option value="4">4 guests</option>
                  <option value="5">5+ guests</option>
                </select>
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-reserve mt-2">
            Reserve
          </button>
          <p class="text-center text-secondary small mt-2 mb-0">You won't be charged yet</p>
        </form>

        <!-- Dynamic Live Price Breakdown -->
        <div class="price-breakdown" id="priceBreakdownBox" style="display: none;">
          <div class="breakdown-row">
            <span>₹<%= (hotel.price || 0).toLocaleString("en-IN") %> &times; <span id="nightsCount">1</span> nights</span>
            <span id="subtotalVal">₹0</span>
          </div>
          <div class="breakdown-row">
            <span>Service & Cleaning Fee (18% GST)</span>
            <span id="gstTaxVal">₹0</span>
          </div>
          <div class="breakdown-row breakdown-total">
            <span>Total before taxes</span>
            <span id="grandTotalVal">₹0</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <hr class="my-5" />

  <!-- Ratings Breakdown Section -->
  <div class="mb-5">
    <h4 class="fw-bold mb-4"><i class="fa-solid fa-star text-dark me-2"></i>4.92 &middot; <%= hotel.review ? hotel.review.length : 0 %> reviews</h4>
    <div class="rating-bar-box">
      <div class="rating-bar-item">
        <span>Cleanliness</span>
        <div class="d-flex align-items-center gap-2">
          <div class="progress-bar-thin"><div class="progress-bar-fill" style="width: 98%;"></div></div>
          <span class="fw-bold">4.9</span>
        </div>
      </div>
      <div class="rating-bar-item">
        <span>Accuracy</span>
        <div class="d-flex align-items-center gap-2">
          <div class="progress-bar-thin"><div class="progress-bar-fill" style="width: 100%;"></div></div>
          <span class="fw-bold">5.0</span>
        </div>
      </div>
      <div class="rating-bar-item">
        <span>Communication</span>
        <div class="d-flex align-items-center gap-2">
          <div class="progress-bar-thin"><div class="progress-bar-fill" style="width: 98%;"></div></div>
          <span class="fw-bold">4.9</span>
        </div>
      </div>
      <div class="rating-bar-item">
        <span>Location</span>
        <div class="d-flex align-items-center gap-2">
          <div class="progress-bar-thin"><div class="progress-bar-fill" style="width: 96%;"></div></div>
          <span class="fw-bold">4.8</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Write Review Form -->
  <% if(currUser) { %>
    <div class="card form-card mb-5">
      <h5 class="fw-bold mb-3">Leave a Review</h5>
      <form action="/listings/<%= hotel._id %>/reviews" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label class="form-label fw-semibold">Rating</label>
          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label fw-semibold">Comments</label>
          <textarea
            name="review[comment]"
            id="comment"
            rows="4"
            class="form-control"
            placeholder="Share your experience staying at this property..."
            required
          ></textarea>
          <div class="invalid-feedback">Please write a comment for your review.</div>
        </div>

        <button class="btn btn-dark rounded-pill px-4">Submit Review</button>
      </form>
    </div>
  <% } %>

  <!-- All Reviews Grid -->
  <h5 class="fw-bold mb-4">Guest Reviews</h5>
  <div class="row g-4">
    <% if (!hotel.review || hotel.review.length === 0) { %>
      <p class="text-secondary ms-3">No reviews yet. Be the first guest to leave a review!</p>
    <% } else { %>
      <% for (review of hotel.review) { %>
        <div class="col-md-6">
          <div class="review-card">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="reviewer-avatar">
                <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'G' %>
              </div>
              <div>
                <h6 class="fw-bold mb-0"><%= review.author ? review.author.username : 'Guest' %></h6>
                <small class="text-secondary">Verified Stay</small>
              </div>
            </div>

            <p class="starability-result mb-2" data-rating="<%= review.rating %>">
              Rated: <%= review.rating %> stars
            </p>

            <p class="card-text text-dark mb-3"><%= review.comment %></p>

            <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
              <form action="/listings/<%= hotel._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                <button class="btn btn-sm btn-outline-danger rounded-pill">
                  <i class="fa-solid fa-trash me-1"></i>Delete Review
                </button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>
    <% } %>
  </div>
</div>

<!-- Flatpickr Setup Script -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const bookedDates = <%- JSON.stringify(bookings || []) %>;

    const checkInDisable = bookedDates.map((booking) => {
      const checkInStr = typeof booking.checkIn === 'string' ? booking.checkIn : new Date(booking.checkIn).toISOString();
      const checkOutStr = typeof booking.checkOut === 'string' ? booking.checkOut : new Date(booking.checkOut).toISOString();
      const end = new Date(checkOutStr);
      end.setUTCDate(end.getUTCDate() - 1);
      return {
        from: checkInStr.split("T")[0],
        to: end.toISOString().split("T")[0]
      };
    });

    const checkOutDisable = bookedDates.map((booking) => {
      const checkInStr = typeof booking.checkIn === 'string' ? booking.checkIn : new Date(booking.checkIn).toISOString();
      const checkOutStr = typeof booking.checkOut === 'string' ? booking.checkOut : new Date(booking.checkOut).toISOString();
      const start = new Date(checkInStr);
      start.setUTCDate(start.getUTCDate() + 1);
      return {
        from: start.toISOString().split("T")[0],
        to: checkOutStr.split("T")[0]
      };
    });

    flatpickr("#checkIn", {
      minDate: "today",
      dateFormat: "Y-m-d",
      disable: checkInDisable
    });

    flatpickr("#checkOut", {
      minDate: "today",
      dateFormat: "Y-m-d",
      disable: checkOutDisable
    });
  });
</script>
