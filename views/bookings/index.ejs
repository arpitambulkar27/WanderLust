<% layout("/layouts/boilerplate.ejs") %>

<div class="container py-5">
  <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
    <div>
      <h1 class="fw-bold mb-1">My Trips</h1>
      <p class="text-secondary small mb-0">Manage your upcoming reservations and view past stays.</p>
    </div>
    <a href="/listings" class="btn btn-outline-dark rounded-pill px-4 fw-semibold">
      <i class="fa-solid fa-magnifying-glass me-1"></i> Explore Stays
    </a>
  </div>

  <% if(!bookings || bookings.length === 0){ %>
    <div class="text-center py-5 my-4 bg-light rounded-4 border">
      <i class="fa-solid fa-suitcase-rolling fs-1 text-secondary mb-3"></i>
      <h3 class="fw-bold text-dark">No trips booked... yet!</h3>
      <p class="text-secondary mb-4">Time to dust off your bags and start planning your next adventure.</p>
      <a href="/listings" class="btn btn-airbnb-primary rounded-pill px-4 py-2 text-white text-decoration-none">
        Start Searching
      </a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% bookings.forEach((booking) => { %>
        <% if(booking.listing) { %>
          <% 
            const nights = Math.ceil((new Date(booking.checkOut) - new Date(booking.checkIn)) / (1000 * 3600 * 24));
          %>
          <div class="col-12">
            <div class="card booking-card shadow-sm">
              <div class="row g-0 align-items-center">
                <!-- Listing Image -->
                <div class="col-lg-4 col-md-5 position-relative">
                  <img
                    src="<%= booking.listing.image && booking.listing.image.url ? booking.listing.image.url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=60' %>"
                    class="booking-img"
                    alt="<%= booking.listing.title %>"
                  />
                  <span class="badge bg-success position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill fw-bold">
                    <i class="fa-solid fa-circle-check me-1"></i>Confirmed
                  </span>
                </div>

                <!-- Booking Details -->
                <div class="col-lg-8 col-md-7 booking-details-col">
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <h3 class="fw-bold mb-0"><%= booking.listing.title %></h3>
                      <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-bold">
                        <%= nights %> <%= nights === 1 ? 'night' : 'nights' %>
                      </span>
                    </div>

                    <p class="text-secondary mb-4">
                      <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                      <%= booking.listing.location %>, <%= booking.listing.country %>
                    </p>

                    <div class="row g-3 mb-4">
                      <div class="col-6 col-md-3">
                        <div class="booking-info">
                          <small class="text-secondary d-block">CHECK-IN</small>
                          <span class="fw-bold text-dark"><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                        </div>
                      </div>

                      <div class="col-6 col-md-3">
                        <div class="booking-info">
                          <small class="text-secondary d-block">CHECKOUT</small>
                          <span class="fw-bold text-dark"><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                        </div>
                      </div>

                      <div class="col-6 col-md-3">
                        <div class="booking-info">
                          <small class="text-secondary d-block">GUESTS</small>
                          <span class="fw-bold text-dark"><%= booking.guests %> <%= booking.guests === 1 ? 'Guest' : 'Guests' %></span>
                        </div>
                      </div>

                      <div class="col-6 col-md-3">
                        <div class="booking-info">
                          <small class="text-secondary d-block">TOTAL PAID</small>
                          <span class="fw-bold text-success fs-6">₹<%= (booking.totalPrice || 0).toLocaleString("en-IN") %></span>
                        </div>
                      </div>
                    </div>

                    <div class="d-flex gap-3 flex-wrap">
                      <a href="/listings/<%= booking.listing._id %>" class="btn btn-dark rounded-pill px-4 fw-semibold">
                        <i class="fa-solid fa-eye me-1"></i> View Property
                      </a>

                      <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST" class="d-inline">
                        <button
                          class="btn btn-outline-danger rounded-pill px-4 fw-semibold"
                          onclick="return confirm('Are you sure you want to cancel this booking?')"
                        >
                          <i class="fa-solid fa-xmark me-1"></i> Cancel Booking
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>
  <% } %>
</div>